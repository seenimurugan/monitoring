# ---------------------------------------------------------------------------
# monitoring — environment variables
# Copy this file to .env, fill in real values, then run ./deploy.sh
# ---------------------------------------------------------------------------

# ── Kubernetes ──────────────────────────────────────────────────────────────
# Namespace to deploy into (deploy.sh creates it if it doesn't exist)
MONITORING_NAMESPACE=monitoring

# ── Grafana admin credentials ────────────────────────────────────────────────
# These are stored as a Kubernetes Secret (grafana-admin-secret) by deploy.sh.
# The plaintext never touches the cluster values files.
# Change the password on first deploy — the default is insecure.
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ── Ingress (Tailscale) ──────────────────────────────────────────────────────
# The hostname prefix for the Tailscale HTTPS ingress.
# Final URL: https://${GRAFANA_INGRESS_HOST}.${TAILNET_DOMAIN}
GRAFANA_INGRESS_HOST=grafana
# Your Tailnet domain — find it at https://login.tailscale.com/admin/dns
# (the "Tailnet name" shown there, e.g. stoat-perch.ts.net)
TAILNET_DOMAIN=stoat-perch.ts.net

# ── Alert secrets — Telegram ─────────────────────────────────────────────────
# Telegram bot token (BotFather → /newbot → copy the token).
# Stored as Secret telegram-alert-config (key: bot_token) by deploy.sh.
# Never commit the real value here; keep it in .env only.
ALERTMANAGER_TELEGRAM_BOT_TOKEN=change-me

# Telegram chat ID to send alerts to. Get it from:
#   https://api.telegram.org/bot<token>/getUpdates  (send /start to the bot first)
# This value is not secret (it's embedded in the Alertmanager config), but is
# kept in .env so deploy.sh and kube-prometheus-stack-values.yaml stay portable.
ALERTMANAGER_TELEGRAM_CHAT_ID=change-me

# ── Alert secrets — WhatsApp ─────────────────────────────────────────────────
# E.164 phone number for WhatsApp alert delivery via the reminders sidecar.
# Stored as Secret whatsapp-alert-config (key: target_number) by deploy.sh.
# Example: +447700900123
ALERTMANAGER_WHATSAPP_TARGET=change-me
